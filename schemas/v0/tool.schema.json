{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool.schema.v0",
  "$comment": "MONOCOQUE_PLACEHOLDER(V0): metrics: drift/complexity computation output contract; MONOCOQUE_PLACEHOLDER(V0): gate: semantic version bump correctness based on schema/registry diffs",
  "title": "Tool schema v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "canonical_path",
    "project_path_rel",
    "kind",
    "commands",
    "placeholders"
  ],
  "properties": {
    "schema": {
      "const": "tool.v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^tool://"
    },
    "project_path_rel": {
      "type": "string",
      "pattern": "^\\[[^\\]]\u002B\\]/"
    },
    "kind": {
      "type": "string",
      "enum": [
        "dotnet"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "example"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "placeholders": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    }
  }
}
