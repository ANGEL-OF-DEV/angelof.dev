<Project>
  <PropertyGroup Label="Default Properties (not applied automatically)">
    <RepoRootNamespace>angelof.dev</RepoRootNamespace>
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <DefaultRootNamespace>$(RepoRootNamespace).$(MSBuildProjectName)</DefaultRootNamespace>
    <DefaultAssemblyName>$(DefaultRootNamespace)</DefaultAssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Standard Properties (applied automatically)">
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Repository Layout">
    <WorktreeRootDirectory>$(MSBuildThisFileDirectory)</WorktreeRootDirectory>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)Artifacts/$(SolutionName)</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="MSBuild Fix - Unsupported repository extension">
    <!--
    Can re-enable from dotnet:release/10.0.2
    See: https://github.com/dotnet/sourcelink/pull/1505
    -->
    <SuppressImplicitGitSourceLink>true</SuppressImplicitGitSourceLink>
  </PropertyGroup>
</Project>
